<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Default suite (mvn clean test): functional tests on Chrome -->
<suite name="SauceDemo Full Regression (Chrome)" verbose="1">

    <test name="Chrome Full Regression">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saucedemo.tests.LoginTests"/>
            <class name="com.saucedemo.tests.InventoryTests"/>
            <class name="com.saucedemo.tests.CheckoutTests"/>
            <class name="com.saucedemo.tests.DataDrivenTests"/>
        </classes>
    </test>

</suite>
