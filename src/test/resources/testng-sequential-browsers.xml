<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Same five journeys on Chrome, then Firefox, then Edge (one browser at a time) -->
<suite name="SauceDemo Sequential Cross-Browser" verbose="1">

    <test name="Chrome Browser Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.saucedemo.tests.CrossBrowserTests"/>
        </classes>
    </test>

    <test name="Firefox Browser Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.saucedemo.tests.CrossBrowserTests"/>
        </classes>
    </test>

    <test name="Edge Browser Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.saucedemo.tests.CrossBrowserTests"/>
        </classes>
    </test>

</suite>
